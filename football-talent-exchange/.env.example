# Base de données PostgreSQL (Neon, Supabase ou locale)
DATABASE_URL="postgresql://fte:fte@localhost:5432/fte"

# Clé secrète pour signer les sessions (32+ caractères aléatoires)
AUTH_SECRET="remplace-moi-par-une-longue-chaine-aleatoire"

# URL publique du site
APP_URL="http://localhost:3000"

# Stripe (laisser vide = mode démo : les abonnements s'activent sans paiement)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Courriels (Resend). Vide = les courriels sont affichés dans la console.
RESEND_API_KEY=""
EMAIL_FROM="Football Talent Exchange <noreply@example.com>"

# Secret pour les tâches automatiques (alertes, expiration des abonnements)
CRON_SECRET="remplace-moi"
