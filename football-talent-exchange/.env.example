# Base de données PostgreSQL (Neon, Supabase ou locale)
DATABASE_URL="postgresql://fte:fte@localhost:5432/fte"

# Clé secrète pour signer les sessions et les envois de fichiers (32+ caractères aléatoires)
AUTH_SECRET="remplace-moi-par-une-longue-chaine-aleatoire"

# URL publique du site
APP_URL="http://localhost:3000"

# --- Paiement par carte : Stripe (vide = mode démo) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Paiement mobile money : Flutterwave (vide = mode démo) ---
FLW_SECRET_KEY=""
# Phrase secrète choisie dans Flutterwave > Settings > Webhooks (champ "Secret hash")
FLW_WEBHOOK_HASH=""
# Taux de change optionnels (unités locales pour 1 $ US), ex. {"XOF":610,"KES":129}
FX_RATES=""

# --- Stockage des vidéos et photos : Cloudflare R2 ou tout service S3 (vide = dossier local ./uploads) ---
S3_ENDPOINT=""          # ex. https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""        # adresse publique du bucket, ex. https://media.mondomaine.com

# --- Vidéos en lecture adaptative : Cloudflare Stream (optionnel, recommandé pour la 3G) ---
# Si rempli, les vidéos vont sur Stream (200 Mo max par envoi) et sont converties en plusieurs qualités.
CF_ACCOUNT_ID=""
CF_STREAM_TOKEN=""      # jeton API avec la permission « Stream: Edit »

# --- Courriels : Resend (vide = courriels affichés dans la console) ---
RESEND_API_KEY=""
EMAIL_FROM="Football Talent Exchange <noreply@example.com>"

# --- Notifications sur le téléphone (Web Push) ---
# Génère les deux clés une seule fois avec : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@mondomaine.com"
# Uniquement pour les tests automatiques (jamais en production)
PUSH_ALLOW_LOCAL_ENDPOINTS=""

# --- Ton adresse : en t'inscrivant avec elle, tu obtiens le compte d'administration ---
ADMIN_EMAILS="toi@exemple.com"

# --- Intelligence artificielle (lecture des CV, rédaction des présentations) ---
# Clé à créer sur console.anthropic.com (paiement à l'usage : quelques centimes par CV lu).
ANTHROPIC_API_KEY=""

# --- Fichiers sur Vercel : Vercel Blob (rempli automatiquement quand on crée le stockage Blob) ---
BLOB_READ_WRITE_TOKEN=""

# --- Paiements de démonstration : seulement pour les essais (jamais sur le vrai site) ---
# PAYMENTS_DEMO="1"

# --- Carte des détections (facultatif) ---
# Sans clé : OpenStreetMap. Avec une clé Google « Geocoding API » : adresses placées par Google.
GOOGLE_MAPS_API_KEY=""

# --- Veille d'actualités (facultatif) ---
# Clé gratuite newsapi.org pour plus d'articles
NEWS_API_KEY=""
# Sources au choix (JSON) ; vide = sources par défaut. Exemple :
# NEWS_FEEDS='[{"name":"BBC Sport","url":"https://feeds.bbci.co.uk/sport/football/rss.xml","language":"en"}]'
NEWS_FEEDS=""

# Secret pour les tâches automatiques (alertes, abonnements, commissions)
CRON_SECRET="remplace-moi"
