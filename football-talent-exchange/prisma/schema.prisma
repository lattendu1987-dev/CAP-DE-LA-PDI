generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLAYER
  GUARDIAN
  RECRUITER
  ADMIN
}

enum RecruiterType {
  CLUB
  COACH
  SCOUT
  AGENT
  TECHNICAL_DIRECTOR
}

enum VerificationStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}

enum Foot {
  RIGHT
  LEFT
  BOTH
}

enum ContractStatus {
  FREE
  UNDER_CONTRACT
}

enum Availability {
  IMMEDIATE
  END_OF_SEASON
  TRIAL_ONLY
  NOT_AVAILABLE
}

enum CompetitionLevel {
  PRO_TOP
  PRO_LOWER
  SEMI_PRO
  AMATEUR
  UNIVERSITY
  YOUTH_ACADEMY
  YOUTH
}

enum PlanCode {
  FREE
  PLAYER_PREMIUM
  RECRUITER_PRO
  RECRUITER_CLUB
}

enum BillingInterval {
  MONTH
  YEAR
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model User {
  id               String             @id @default(cuid())
  email            String             @unique
  passwordHash     String
  name             String
  role             Role
  country          String             @default("CA")
  locale           String             @default("fr")
  identityVerified Boolean            @default(false)
  suspended        Boolean            @default(false)
  createdAt        DateTime           @default(now())

  sessions         Session[]
  player           PlayerProfile?     @relation("PlayerUser")
  guardedPlayers   PlayerProfile[]    @relation("GuardianUser")
  recruiter        RecruiterProfile?
  subscription     Subscription?
  participations   Participant[]
  messages         Message[]
  reportsMade      Report[]           @relation("Reporter")
  reportsReceived  Report[]           @relation("Reported")
  blocks           Block[]            @relation("Blocker")
  blockedBy        Block[]            @relation("Blocked")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PlayerProfile {
  id                String           @id @default(cuid())
  slug              String           @unique
  userId            String           @unique
  user              User             @relation("PlayerUser", fields: [userId], references: [id], onDelete: Cascade)
  guardianId        String?
  guardian          User?            @relation("GuardianUser", fields: [guardianId], references: [id], onDelete: SetNull)
  guardianEmail     String?
  guardianConsentAt DateTime?

  firstName         String
  lastName          String
  birthDate         DateTime
  nationalities     String[]
  country           String
  city              String?
  languages         String[]
  photoUrl          String?
  bio               String?

  heightCm          Int?
  weightKg          Int?
  foot              Foot?
  mainPosition      String?
  otherPositions    String[]

  currentLevel      CompetitionLevel?
  contractStatus    ContractStatus   @default(FREE)
  contractEnd       DateTime?
  hasAgent          Boolean          @default(false)
  availability      Availability     @default(IMMEDIATE)
  willingToRelocate Boolean          @default(false)
  relocationCountries String[]

  published         Boolean          @default(true)
  featuredUntil     DateTime?
  viewCount         Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  career            CareerEntry[]
  stats             SeasonStat[]
  videos            Video[]
  shortlistItems    ShortlistItem[]
  evaluations       Evaluation[]
  views             ProfileView[]
}

model CareerEntry {
  id         String            @id @default(cuid())
  playerId   String
  player     PlayerProfile     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  club       String
  kind       String            @default("CLUB")
  level      CompetitionLevel?
  country    String?
  startYear  Int
  endYear    Int?
  notes      String?
}

model SeasonStat {
  id           String        @id @default(cuid())
  playerId     String
  player       PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)
  season       String
  club         String
  matches      Int           @default(0)
  minutes      Int           @default(0)
  goals        Int           @default(0)
  assists      Int           @default(0)
  yellowCards  Int           @default(0)
  redCards     Int           @default(0)
  cleanSheets  Int           @default(0)
  saves        Int           @default(0)
  verified     Boolean       @default(false)
}

model Video {
  id         String           @id @default(cuid())
  playerId   String
  player     PlayerProfile    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  title      String
  url        String
  kind       String           @default("HIGHLIGHTS")
  createdAt  DateTime         @default(now())
  moments    VideoMoment[]
}

model VideoMoment {
  id       String @id @default(cuid())
  videoId  String
  video    Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  seconds  Int
  label    String
}

model RecruiterProfile {
  id            String             @id @default(cuid())
  userId        String             @unique
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          RecruiterType
  organization  String
  website       String?
  fifaLicense   String?
  country       String
  verification  VerificationStatus @default(PENDING)
  createdAt     DateTime           @default(now())

  shortlists    Shortlist[]
  savedSearches SavedSearch[]
  evaluations   Evaluation[]
}

model Shortlist {
  id          String          @id @default(cuid())
  recruiterId String
  recruiter   RecruiterProfile @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  name        String
  createdAt   DateTime        @default(now())
  items       ShortlistItem[]
}

model ShortlistItem {
  id          String        @id @default(cuid())
  shortlistId String
  shortlist   Shortlist     @relation(fields: [shortlistId], references: [id], onDelete: Cascade)
  playerId    String
  player      PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)
  note        String?
  createdAt   DateTime      @default(now())

  @@unique([shortlistId, playerId])
}

model Evaluation {
  id          String           @id @default(cuid())
  recruiterId String
  recruiter   RecruiterProfile @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  playerId    String
  player      PlayerProfile    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  technical   Int
  physical    Int
  tactical    Int
  mental      Int
  comment     String?
  updatedAt   DateTime         @updatedAt

  @@unique([recruiterId, playerId])
}

model SavedSearch {
  id            String           @id @default(cuid())
  recruiterId   String
  recruiter     RecruiterProfile @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  name          String
  query         String
  alertsEnabled Boolean          @default(true)
  lastAlertAt   DateTime         @default(now())
  createdAt     DateTime         @default(now())
}

model ProfileView {
  id        String        @id @default(cuid())
  playerId  String
  player    PlayerProfile @relation(fields: [playerId], references: [id], onDelete: Cascade)
  viewerId  String?
  createdAt DateTime      @default(now())
}

model Conversation {
  id           String        @id @default(cuid())
  playerId     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  participants Participant[]
  messages     Message[]
}

model Participant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime     @default(now())

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  scamFlags      String[]
  trialDate      DateTime?
  trialPlace     String?
  createdAt      DateTime     @default(now())
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  reporter   User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedId String
  reported   User         @relation("Reported", fields: [reportedId], references: [id], onDelete: Cascade)
  reason     String
  details    String?
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 PlanCode
  interval             BillingInterval    @default(MONTH)
  status               SubscriptionStatus
  amountCents          Int                @default(0)
  currency             String             @default("usd")
  currentPeriodEnd     DateTime
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  updatedAt            DateTime           @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  details   String?
  createdAt DateTime @default(now())
}
