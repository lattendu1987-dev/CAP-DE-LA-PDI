    "@fontsource-variable/noto-kufi-arabic": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@prisma/client": "6.19.3",
    "@vercel/blob": "2.8.1",
    "bcryptjs": "3.0.3",
    "leaflet": "1.9.4",
    "mammoth": "1.12.3",
    "mediabunny": "1.61.1",
    "next": "15.5.28",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "server-only": "0.0.1",
    "stripe": "23.0.1",
